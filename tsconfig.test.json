{
  // T467/V354: TESTIT TYPECHECKIN PIIRIIN — `tsconfig.json`in `include` on `["src"]` ∴ 280
  // tiedostoa `tests/`+`e2e/`:ssä oli rajan ulkopuolella & symbolin siirto moduulista toiseen
  // saattoi jättää testin rikki tavalla jonka tyyppijärjestelmä olisi nähnyt (B201).
  //
  // Miksi ERILLINEN konfiguraatio ⊥ pelkkä `include`-laajennus: testeissä on tarkoituksellisia
  // stubbeja (`as any` -mockit, vajaat Leaflet-tuplat) & apureita joita ⊥ kutsuta joka
  // tiedostosta. Yhteen tiukkaan konfiguraatioon pakotettuna ne vaatisivat joko `src`:n sääntöjen
  // löysentämistä TAI mockien kirjoittamista uusiksi — kumpikin väärä hinta. Löysennykset alla
  // ovat siis VALINTA joka on perusteltu (V354), ⊥ oletus jota kukaan ⊥ ole valinnut.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Käyttämätön apuri testitiedostossa ⊥ ole vika samalla tavalla kuin `src`:ssä: testi
    // rakentaa usein fixtuurin josta se käyttää osaa. Nämä ovat AINOAT löysennykset —
    // `strict` pysyy päällä, koska juuri se näkee väärän importin & väärän muodon.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Testit ajetaan node/bun-ympäristössä: `require`, `__dirname` & `process` ovat siellä
    // olemassa vaikka selainkoodissa ⊥ olisi. `src` ⊥ saa näitä — se on selainbundle.
    "types": ["vite/client", "node"],
    // `src` on ES2020 koska se on selainbundle jonka kohde on kalibroitu; testit ajaa node/bun
    // ∴ `Array.prototype.at` & muu ES2022 on niissä käytettävissä ILMAN että selaimen kohde
    // liikkuu. Eri lib on tässä oikea vastaus, ⊥ `as any` jokaiseen `.at()`-kutsuun.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["tests", "e2e"],

  // ─── VELKALISTA (T467(b)) ─────────────────────────────────────────────────────────────
  // Ensimmäinen ajo: 148 virhettä / 48 tiedostoa. `node`-tyypit & ES2022-lib veivät sen
